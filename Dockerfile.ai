# syntax=docker/dockerfile:1.7
FROM python:3.11-slim@sha256:233de06753d30d120b1a3ce359d8d3be8bda78524cd8f520c99883bfe33964cf

WORKDIR /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install minimal system dependency for healthcheck tooling.
RUN apt-get update && apt-get install -y \
    tini \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system appgroup && useradd --system --gid appgroup --create-home appuser

# Install runtime Python dependencies for the AI gateway only.
COPY requirements.ai.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r requirements.ai.txt

# Copy AI source files
COPY app.py .
COPY iot_db.py .
COPY models/__init__.py ./models/__init__.py
COPY models/tanka.py ./models/tanka.py

RUN mkdir -p /app/public/images/icons /tmp \
    && chown -R appuser:appgroup /app /tmp

USER appuser

# Expose Flask port
EXPOSE 5000

ENTRYPOINT ["tini", "--"]

# Run with waitress (production)
CMD ["python", "-m", "waitress", "--host=0.0.0.0", "--port=5000", "app:app"]
