FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (gcc for psycopg2, git for CLIP install from GitHub)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    libffi-dev \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install base Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install CLIP dependencies (ftfy, regex, tqdm) then CLIP itself from GitHub
# This mirrors: pip install ftfy regex tqdm && pip install git+https://github.com/openai/CLIP.git
# (conda pytorch=1.7.1 cudatoolkit=11.0 is handled by the torch wheel above via requirements.txt)
RUN pip install --no-cache-dir ftfy regex tqdm
RUN pip install --no-cache-dir git+https://github.com/openai/CLIP.git

# Install MolScribe and its dependencies.
# - molscribe/OpenNMT-py/SmilesPE are installed --no-deps to avoid torch<2.0,
#   torchtext==0.5.0, and fastprogress->python-fasthtml dep chain conflicts.
# - Safe non-conflicting deps are installed normally first.
COPY models/requirements.txt ./models/requirements.txt
RUN pip install --no-cache-dir \
        "opencv-python-headless>=4.5.5" \
        "albumentations==1.1.0" \
        "timm>=0.9.0" \
        "einops>=0.6.0" \
        "configargparse" \
        "pyonmttok>=1.23,<2" \
        "rdkit-pypi>=2021.03.2" && \
    pip install --no-cache-dir "SmilesPE==0.0.3" --no-deps && \
    pip install --no-cache-dir "OpenNMT-py==2.2.0" --no-deps && \
    pip install --no-cache-dir molscribe --no-deps

# Copy AI source files
COPY app.py .
COPY iot_db.py .
COPY seed_vectors.py .
COPY models/ ./models/

# Expose Flask port
EXPOSE 5000

# Run with waitress (production)
CMD ["python", "-m", "waitress", "--host=0.0.0.0", "--port=5000", "app:app"]
