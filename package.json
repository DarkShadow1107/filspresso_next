{
	"name": "filspresso_next",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build --turbopack",
		"start": "next start",
		"lint": "eslint src --ext .ts,.tsx,.js,.jsx",
		"test:playground-sessions": "node nestjs-backend/node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.json --test tests/client/playground-sessions.test.ts",
		"test:playground-runs": "node nestjs-backend/node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.json --test tests/client/playground-run-history.test.tsx",
		"test:playground-agent": "node nestjs-backend/node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.json --test tests/client/playground-agent.test.ts",
		"test:playground-agent-review": "node nestjs-backend/node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.json --test tests/client/playground-agent-review.test.tsx",
		"test:playground-agent-loop": "node nestjs-backend/node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.json --test tests/client/playground-agent-loop.test.ts tests/client/playground-agent-consent.test.ts",
		"test:playground-hosted-agent": "node nestjs-backend/node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.json --test tests/client/playground-hosted-agent.test.tsx",
		"backend:nest:build": "npm --prefix nestjs-backend run build",
		"backend:nest:start": "npm --prefix nestjs-backend run start",
		"backend:nest:test": "npm --prefix nestjs-backend run test",
		"security:bootstrap-secrets": "node scripts/bootstrapSecretsFromEnv.mjs",
		"security:bootstrap-secrets:dry-run": "node scripts/bootstrapSecretsFromEnv.mjs --dry-run",
		"security:generate-secrets-docker": "node scripts/generateSecretsInDocker.mjs",
		"security:generate-mtls-dev": "node scripts/generateDevMtlsCerts.mjs",
		"security:verify-signed-history": "node scripts/verifySignedHistory.mjs",
		"security:verify-docker-bases": "node scripts/verifyDockerfileBaseImages.mjs",
		"security:verify-deploy-signature-policy": "node scripts/verifyDeploySignaturePolicy.mjs"
	},
	"dependencies": {
		"axios": "^1.15.2",
		"dinero.js": "^2.0.1",
		"motion": "^12.26.1",
		"next": "^16.2.1",
		"node-forge": "^1.4.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/oxide-win32-x64-msvc": "^4.2.2",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@typescript-eslint/eslint-plugin": "^8",
		"baseline-browser-mapping": "^2.10.0",
		"cheerio": "^1.1.2",
		"cssnano": "^7.1.1",
		"eslint": "^9",
		"eslint-config-next": "^16.2.1",
		"eslint-plugin-react": "^7.36.1",
		"eslint-plugin-react-hooks": "^5.0.0",
		"lightningcss-win32-x64-msvc": "^1.32.0",
		"postcss-preset-env": "^10.1.1",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"overrides": {
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3"
	}
}
