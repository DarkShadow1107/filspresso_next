        SecurityObservability["security-observability/<br/>Metrics, alerts, webhooks"]
        HealthModule["health/<br/>Multi-service health checks"]
    end

    subgraph Admin_Data["Data Sources"]
        AuthEvents["auth_security_events<br/>Login attempts, failures"]
        LoginAttempts["auth_login_attempts<br/>Brute force tracking"]
        SecurityLedger["security_event_ledger<br/>SHA3-256 hash chain"]
        AccountsTable["accounts<br/>User data, roles"]
        OrdersTable["orders<br/>Order records"]
        ProductsTable["coffee_products, machine_products"]
        RepairsTable["repairs"]
        SubscriptionsTable["subscriptions, user_subscriptions"]
    end

    subgraph Admin_Security["Admin Security Controls"]
        AdminAuth["Admin JWT Guard<br/>role='admin' required"]
        OPAPolicy["OPA Policy<br/>admin:* resource access"]
        ReadOnlySQL["Read-only DB connection<br/>No INSERT/UPDATE/DELETE"]
        AuditLogging["SHA3-256 ledger entry<br/>for each admin action"]
    end

