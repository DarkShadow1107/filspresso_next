---
title: Filspresso Next - Terraform/Infrastructure Architecture Diagram
---

flowchart TB
    subgraph Terraform["Terraform Configuration (infrastructure/terraform/)"]
        direction TB
        MainConfig["main.tf<br/>Provider configuration<br/>Terraform settings"]
        VariablesConfig["variables.tf<br/>Input variables<br/>Region, bucket name, etc."]
        OutputsConfig["outputs.tf<br/>Output values<br/>Bucket ARN, endpoint"]
        S3Backend["backend.tf<br/>Remote state storage<br/>S3 backend config"]
    end

    subgraph AWS_Resources["AWS Resources Provisioned"]
        direction TB
        S3Bucket["S3 Bucket<br/>Transparency Backend<br/>Object Lock enabled"]
        IAMUser["IAM User<br/>Terraform deployer<br/>Least privilege policy"]
        IAMPolicy["IAM Policy<br/>s3:PutObject, s3:GetObject<br/>s3:PutObjectRetention"]
        BucketPolicy["Bucket Policy<br/>Deny insecure transport<br/>Require encryption at rest"]
    end

    subgraph S3_Configuration["S3 Bucket Configuration"]
        ObjectLock["Object Lock<br/>Governance mode<br/>Prevent deletion/modification"]
        Versioning["Versioning<br/>Keep all versions<br/>Audit trail"]
        Encryption["Encryption<br/>SSE-S3 or SSE-KMS<br/>AES-256 at rest"]
        LifecycleRules["Lifecycle Rules<br/>Transition to Glacier<br/>after N days"]
        AccessLogging["Access Logging<br/>Log all bucket access<br/>to separate bucket"]
    end

    subgraph Transparency_Backend["Transparency Backend Purpose"]
        SecurityLedger["Security Event Ledger<br/>SHA3-256 hash chain<br/>Tamper-evident log"]
        AnchorStorage["Anchor Storage<br/>Store ledger anchors<br/>Cryptographic proofs"]
        AuditTrail["Audit Trail<br/>Immutable record<br/>Compliance requirement"]
        Verification["Verification<br/>Third-party auditors<br/>Verify ledger integrity"]
    end

    subgraph Deployment_Flow["Deployment Flow"]
        LocalDev["Local Development<br/>terraform init<br/>terraform plan"]
        CI_Pipeline["CI Pipeline<br/>GitHub Actions<br/>terraform apply"]
        StateManagement["State Management<br/>Remote state in S3<br/>State locking with DynamoDB"]
        DriftDetection["Drift Detection<br/>Scheduled plan checks<br/>Alert on drift"]
    end

    MainConfig --> S3Backend
    VariablesConfig --> MainConfig
    OutputsConfig --> MainConfig

    MainConfig --> S3Bucket
    MainConfig --> IAMUser
    MainConfig --> IAMPolicy
    MainConfig --> BucketPolicy

    S3Bucket --> ObjectLock
    S3Bucket --> Versioning
    S3Bucket --> Encryption
    S3Bucket --> LifecycleRules
    S3Bucket --> AccessLogging

    S3Bucket --> SecurityLedger
    SecurityLedger --> AnchorStorage
    AnchorStorage --> AuditTrail
    AuditTrail --> Verification

    LocalDev --> CI_Pipeline
    CI_Pipeline --> StateManagement
    StateManagement --> DriftDetection
    DriftDetection --> S3Bucket

