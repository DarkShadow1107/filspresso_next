---
title: Filspresso Next - Next.js API Route Handler Architecture
---

flowchart TB
    subgraph Client["Client Browser"]
        Browser["Browser Requests<br/>Fetch/Axios calls"]
    end

    subgraph NextJS_API["Next.js API Route Handlers (src/app/api/)"]
        direction TB

        subgraph Proxy_Routes["Proxy Route Handlers"]
            direction TB
            AccountsProxy["/api/accounts/[...path]<br/>proxy → NestJS /accounts/*"]
            AuthProxy["/api/auth/[...path]<br/>proxy → NestJS /auth/*"]
            CartProxy["/api/cart/[...path]<br/>proxy → NestJS /cart/*"]
            OrdersProxy["/api/orders/[...path]<br/>proxy → NestJS /orders/*"]
            ProductsProxy["/api/products/[...path]<br/>proxy → NestJS /products/*"]
            FavoritesProxy["/api/favorites/[...path]<br/>proxy → NestJS /favorites/*"]
            CardsProxy["/api/cards/[...path]<br/>proxy → NestJS /cards/*"]
            RepairsProxy["/api/repairs/[...path]<br/>proxy → NestJS /repairs/*"]
            WeatherProxy["/api/weather/[...path]<br/>proxy → NestJS /weather/*"]
            KafelotProxy["/api/kafelot/[...path]<br/>proxy → NestJS /kafelot/*"]
            AdminProxy["/api/admin/[...path]<br/>proxy → NestJS /admin/*"]
            SubscriptionsProxy["/api/subscriptions/[...path]<br/>proxy → NestJS /subscriptions/*"]
            FXProxy["/api/fx/[...path]<br/>proxy → NestJS /fx/*"]
            IconsProxy["/api/icons/[...path]<br/>proxy → NestJS /icons/*"]
            MoleculeProxy["/api/molecule/[...path]<br/>proxy → NestJS /molecule/*"]
        end

        subgraph Direct_Routes["Direct Route Handlers"]
            direction TB
            PythonChat["/api/python-chat/route.ts<br/>→ Python AI /chat"]
            PythonHealth["/api/python-health/route.ts<br/>→ Python AI /health"]
            ServicesHealth["/api/services-health/route.ts<br/>→ Aggregate all service health"]
            ModelInfo["/api/model/route.ts<br/>→ Python AI /model/info"]
            ChatSessions["/api/chat/route.ts<br/>→ NestJS /chat sessions"]
            ChatSave["/api/chat/save/route.ts<br/>→ NestJS /chat save/load"]
            Subscribe["/api/subscribe/route.ts<br/>→ Kotlin /quote + NestJS"]
        end
    end

    subgraph Proxy_Logic["Proxy Middleware Logic"]
        direction TB
        RewriteConfig["proxy.ts<br/>Next.js rewrites config<br/>Maps /api/* → backend URLs"]
        AuthForward["Auth header forwarding<br/>Cookie sid → Bearer JWT"]
        ErrorTransform["Error response transformation<br/>NestJS errors → Next.js format"]
        TimeoutHandler["Request timeout handling<br/>AbortController for long requests"]
        CORSHandling["CORS header management<br/>Origin validation"]
    end

    subgraph Backend_Services["Backend Services"]
        NestJS["NestJS Backend<br/>Port :4000<br/>Commerce, Auth, Orders, Cart"]
        PythonAI["Python AI Service<br/>Port :5000<br/>LLM, Embeddings, Chemistry"]
        KotlinSub["Kotlin Subscriptions<br/>Port :8084<br/>Quote engine"]
    end

