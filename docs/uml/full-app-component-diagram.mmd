---
title: Filspresso Next - Container / Component Diagram
---

flowchart LR
    U[User Browser] --> N[Next.js App Router<br/>BFF & UI Renderer<br/>Port :3000]

    N --> NEST[NestJS Backend<br/>Commerce & Auth Core<br/>Port :4000]
    N --> P[Python AI Service<br/>Flask Gateway<br/>Port :5000]
    N --> RUST[Rust Crypto Service<br/>Actix-web<br/>Port :8090]

    subgraph NestJS_Modules["NestJS Modules (nestjs-backend/src/)"]
        direction TB
        AUTH[auth/<br/>AuthController, AuthService<br/>JWT EdDSA/HS256, Argon2id<br/>Google/Apple OAuth, MFA, Sessions]
        ACCOUNTS[accounts/<br/>AccountsController, AccountsService<br/>User CRUD, profile, membership]
        CARDS[cards/<br/>CardsController, CardsService<br/>AES-256-GCM encrypted cards]
        CART[cart/<br/>CartController, CartService<br/>Stock reservation validation]
        ORDERS[orders/<br/>OrdersController, OrdersService<br/>SELECT FOR UPDATE checkout]
        PRODUCTS[products/<br/>ProductsController, ProductsService<br/>Coffee + Machine catalog]
        FAVORITES[favorites/<br/>FavoritesController, FavoritesService<br/>User product bookmarks]
        CHAT[chat/<br/>ChatController, ChatService<br/>Sessions, messages, tokens]
        KAFELOT[kafelot/<br/>KafelotController, KafelotService<br/>Prompt quota management]
        ADMIN[admin/<br/>AdminController, AdminService<br/>Security telemetry, raw SQL]
        REPAIRS[repairs/<br/>RepairsController, RepairsService<br/>Warranty request lifecycle]
        SUBS[subscriptions/<br/>SubscriptionsController, SubscriptionsService<br/>Plans, user subscriptions]
        SUBS_ENGINE[subscriptions-engine/<br/>Proxy to Kotlin service<br/>Quotes, reconciliation]
        OPS[operations/<br/>OperationsController, OperationsService<br/>Proxy to Go Ops events]
        CRYPTO[crypto/<br/>CryptoController, CryptoService<br/>Proxy to Rust Crypto]
        WEATHER[weather/<br/>WeatherController, WeatherService<br/>Weather API + caching]
        HEALTH[health/<br/>HealthController, HealthService<br/>Multi-service health, incidents]
        SEC_OBS[security-observability/<br/>Metrics, alerts, webhooks<br/>ServiceEventsAuthGuard]
        SECURITY[security/<br/>Service assertions, egress policy<br/>OPA integration, PolicyGuard]
        INTEGRATIONS[integrations/<br/>Cross-service communication<br/>Java, Kotlin, Go, Rust, Python]
        DATABASE[database/<br/>PostgreSQL pool, schema verify<br/>ensureAppSchema]
        CONFIG[config/<br/>Env validation with Joi<br/>Configuration constants]
        COMMON[common/<br/>Guards, decorators, interceptors<br/>Global filters]
    end

