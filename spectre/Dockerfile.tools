FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --upgrade pip \
    && pip install \
      "fastapi>=0.115,<1" \
      "uvicorn>=0.30,<1" \
      "pydantic>=2.8,<3" \
      "anyio>=4.4,<5" \
      "httpx>=0.27,<1" \
      "python-docx>=1.1,<2" \
      "openpyxl>=3.1,<4" \
      "python-pptx>=1.0,<2" \
      "reportlab>=4.2,<5" \
      "pillow>=10.4,<12" \
      "pillow-heif>=0.21,<2" \
      "scrapling[fetchers]>=0.4.15,<0.5"

WORKDIR /srv/tools
COPY tools ./tools

RUN mkdir -p /srv/tools/files /srv/tools/repositories /srv/tools/knowledge && \
    useradd --create-home --uid 10001 tooluser && \
    chown -R tooluser:tooluser /srv/tools

USER tooluser

CMD ["uvicorn", "tools.main:app", "--host", "0.0.0.0", "--port", "8091"]
