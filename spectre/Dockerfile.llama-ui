FROM node:22-alpine AS ui-build

ARG LLAMA_CPP_REV=f280b26983ad0fdb705a0d9ebf0503e76f2899b0

RUN apk add --no-cache curl tar && \
    mkdir -p /src && \
    curl --fail --location --silent --show-error \
      "https://github.com/ggml-org/llama.cpp/archive/${LLAMA_CPP_REV}.tar.gz" | \
      tar -xz --strip-components=1 -C /src

WORKDIR /src

COPY llama-ui/spectre-controls.js tools/ui/static/spectre-controls-v2.js
COPY llama-ui/spectre-core/ tools/ui/src/lib/spectre/

RUN sed -i '/%sveltekit.body%/a\        <script src="/spectre-controls-v2.js"></script>' \
      tools/ui/src/app.html && \
    sed -i "s|import '../app.css';|import '../app.css';\nimport '\$lib/spectre/core';|" \
      tools/ui/src/routes/+layout.svelte && \
    sed -i '/components\/pwa/d; /use-pwa\.svelte/d; /const pwa = usePwa()/d; /const { needRefresh, updateServiceWorker } = pwa;/d; /virtual:pwa-assets\/head/d; /{#if pwaAssetsHead.themeColor}/,/{\/if}/d; /{#each pwaAssetsHead.links/,/{\/each}/d; /<PwaMetaTags \/>/d; /<PwaRefreshAlert/,/\/>/d' tools/ui/src/routes/+layout.svelte && \
    sed -i '/SVELTEKIT_PWA_OPTIONS/d; /@vite-pwa\/sveltekit/d; /SvelteKitPWA(SVELTEKIT_PWA_OPTIONS)/d' tools/ui/vite.config.ts && \
    sed -i "s|return modelProps?.ui !== false;|if (!/lfm/i.test(option.model)) return false;\n\t\t\treturn modelProps?.ui !== false;|" \
      tools/ui/src/lib/hooks/use-models-selector.svelte.ts && \
    sed -i '/<!-- Chat Template -->/,/^[[:space:]]*{\/if}$/d' \
      tools/ui/src/lib/components/app/dialogs/DialogModelInformation.svelte && \
    sed -i '/^[[:space:]]*\/\/ Sampling$/,/^[[:space:]]*\/\/ Developer$/ { /^[[:space:]]*\/\/ Developer$/!d; }' \
      tools/ui/src/lib/constants/settings.constants.ts && \
    sed -i '/^[[:space:]]*Funnel,$/d' \
      tools/ui/src/lib/constants/settings.constants.ts && \
    sed -i '/ChatFormActionAddReasoningSubmenu/d' \
      tools/ui/src/lib/components/app/chat/ChatForm/ChatFormActions/ChatFormActionAdd/ChatFormActionAddDropdown.svelte && \
    sed -i "s|{#if parsed.params}|{#if parsed.params \&\& parsed.params.toUpperCase() !== '3B'}|" \
      tools/ui/src/lib/components/app/models/ModelId.svelte && \
    sed -i "s@{entry.definition.function.name}@{entry.definition.function.name.replace(/^Tools_/i, '').replaceAll('_', ' ').replace(/(^| )([a-z])/gi, (_, prefix, char) => prefix + char.toUpperCase()).replace(/\\bCve\\b/g, 'CVE')}@" \
      tools/ui/src/lib/components/app/chat/ChatForm/ChatFormActions/ChatFormActionAdd/ChatFormActionAddToolsSubmenu.svelte && \
    grep -n "spectre" tools/ui/src/app.html tools/ui/src/routes/+layout.svelte

RUN apk add --no-cache python3

RUN sed -i "s@interface LiveStats {@const SPECTRE_CONTEXT_OPTIONS = [32768, 65536, 131072];\n\nfunction spectreSelectedContext(): number | null {\n  if (typeof window === 'undefined') return null;\n  try {\n    const value = Number(JSON.parse(localStorage.getItem('spectre.ui.settings.v1') || '{}').context_size);\n    return SPECTRE_CONTEXT_OPTIONS.includes(value) ? value : null;\n  } catch {\n    return null;\n  }\n}\n\ninterface LiveStats {@" \
  tools/ui/src/lib/stores/chat/context-stats.svelte.ts

RUN sed -i "s|class ContextStatsStore {|class ContextStatsStore {\n  private spectreContextSettingsVersion = \$state(0);\n\n  constructor() {\n    if (typeof window !== 'undefined') {\n      window.addEventListener('spectre-settings-change', () => {\n        this.spectreContextSettingsVersion += 1;\n      });\n    }\n  }|" \
  tools/ui/src/lib/stores/chat/context-stats.svelte.ts

RUN sed -i "s|void modelsStore.props.cacheVersion;|this.spectreContextSettingsVersion;\n\t\tconst configuredContext = spectreSelectedContext();\n\t\tif (configuredContext !== null) return configuredContext;\n\t\tvoid modelsStore.props.cacheVersion;|" \
  tools/ui/src/lib/stores/chat/context-stats.svelte.ts

COPY llama-ui/CollapsibleContentBlock.patched.svelte tools/ui/src/lib/components/app/content/CollapsibleContentBlock.svelte
COPY llama-ui/ChatMessageAgenticContent.patched.svelte tools/ui/src/lib/components/app/chat/ChatMessages/ChatMessageAgenticContent.svelte
COPY llama-ui/ChatMessageReasoningBlock.patched.svelte tools/ui/src/lib/components/app/chat/ChatMessages/ChatMessageReasoningBlock.svelte
COPY llama-ui/ChatMessageToolCallBlock.patched.svelte tools/ui/src/lib/components/app/chat/ChatMessages/ChatMessage/ChatMessageToolCall/ChatMessageToolCallBlock.svelte
COPY llama-ui/ChatMessageToolCallBlockRunPython.svelte tools/ui/src/lib/components/app/chat/ChatMessages/ChatMessage/ChatMessageToolCall/ChatMessageToolCallBlockRunPython.svelte
COPY llama-ui/tool-ui.patched.ts tools/ui/src/lib/utils/tool-ui.ts
RUN rm -rf /src/tools/ui/.svelte-kit /src/tools/ui/dist && echo "cleaned svelte-kit"
WORKDIR /src/tools/ui

RUN npm ci && npm run build

FROM ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:a2d04d1d1c2b2abe287fef9a22a3700a7fa20aec4c4ab56135e0099f38119848

COPY --from=ui-build /src/tools/ui/dist /webui
COPY llama-ui/spectre-mcp.py /app/spectre-mcp.py
COPY llama-ui/spectre-mcp.json /app/spectre-mcp.json
COPY llama-ui/account/index.html /webui/account/index.html

ENTRYPOINT ["/app/llama-server"]
