{
	admin off
	local_certs
	default_sni 127.0.0.1
}

https://127.0.0.1:8080, https://localhost:8080 {
	tls internal
	encode zstd gzip
	request_body {
		max_size 52MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self' ws: wss:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	@tools path /tools-api/*
	handle @tools {
		uri strip_prefix /tools-api
		reverse_proxy tools:8091
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:8000
	}

	@legacy_llama path /llama /llama/*
	handle @legacy_llama {
		uri strip_prefix /llama
		reverse_proxy llama-ui:8080 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy llama-ui:8080 {
			flush_interval -1
		}
	}
}
