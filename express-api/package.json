{
	"name": "filspresso-express-api",
	"version": "1.0.0",
	"description": "Express.js API server for Filspresso Next - connects Next.js frontend with PostgreSQL database",
	"main": "server.js",
	"scripts": {
		"start": "node server.js",
		"dev": "nodemon server.js",
		"test:internal-assertion-matrix": "node --test tests/internal_assertion_matrix.test.mjs",
		"security:verify-ledger": "node scripts/verify_security_ledger.js",
		"security:anchor-ledger": "node scripts/anchor_security_ledger.js",
		"security:archive-ledger": "node scripts/archive_security_ledger.js",
		"security:anomaly-report": "node scripts/security_anomaly_report.js",
		"security:post-incident-check": "node scripts/post_incident_integrity_check.js",
		"security:containment-playbook": "node scripts/incident_containment_playbook.js",
		"security:issue-service-assertion": "node scripts/issue_service_assertion.js",
		"security:rotate-managed-key": "node scripts/rotate_managed_key.js"
	},
	"dependencies": {
		"@react-email/components": "^1.0.11",
		"@react-email/render": "^2.0.5",
		"argon2": "^0.41.1",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.5",
		"crypto-js": "^4.2.0",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"express-rate-limit": "^7.1.5",
		"helmet": "^7.1.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.0.2",
		"pg": "^8.11.3",
		"qrcode": "^1.5.4",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sharp": "^0.34.5",
		"uuid": "^9.0.1"
	},
	"devDependencies": {
		"nodemon": "^3.0.2"
	}
}
