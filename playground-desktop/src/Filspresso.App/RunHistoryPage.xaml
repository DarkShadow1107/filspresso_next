<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Filspresso.App.RunHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28,16,28,24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
        <StackPanel Spacing="8">
            <TextBlock Text="Recorded activity" FontSize="28" />
            <TextBlock Text="Read-only history, not a conversation transcript or a rerun. Logs are bounded and may expire or be deleted. No completion record does not mean a job is still running." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="18">
            <CheckBox x:Name="OnlyConversation" Content="Only this saved conversation" IsEnabled="False" Click="OnFilterChanged" />
            <Button Content="Refresh activity" Click="OnRefresh" Style="{StaticResource QuietButtonStyle}" />
        </StackPanel>
        <TextBlock x:Name="HistoryStatus" Grid.Row="2" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoMuted}" AutomationProperties.LiveSetting="Polite" />
        <Grid Grid.Row="3" ColumnDefinitions="270,*" ColumnSpacing="22">
            <ListView x:Name="RunsList" SelectionMode="Single" SelectionChanged="OnRunSelected" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Recent recorded runs">
                <ListView.ItemTemplate><DataTemplate>
                    <StackPanel Spacing="6" Padding="4,10">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource FilspressoMuted}" />
                        <TextBlock Text="{Binding Run.RunId}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource FilspressoMuted}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                <StackPanel Spacing="7">
                    <TextBlock x:Name="RunHeading" Text="Choose a run to inspect its recorded events." TextWrapping="Wrap" FontSize="17" />
                    <TextBlock x:Name="RunDescription" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoMuted}" />
                </StackPanel>
                <TextBlock x:Name="RunWarnings" Grid.Row="1" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoAccent}" />
                <TextBlock x:Name="ReplayStatus" Grid.Row="2" TextWrapping="Wrap" FontSize="11" AutomationProperties.LiveSetting="Polite" />
                <ListView x:Name="EventsList" Grid.Row="3" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Recorded run events">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate><DataTemplate>
                        <Border BorderBrush="{StaticResource FilspressoBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource FilspressoMuted}" />
                                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoAccent}" />
                                <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding Payload}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="11" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16">
                    <Button x:Name="FirstPageButton" Content="Back to first events" IsEnabled="False" Click="OnFirstPage" Style="{StaticResource QuietButtonStyle}" />
                    <Button x:Name="NextPageButton" Content="Next recorded events" IsEnabled="False" Click="OnNextPage" Style="{StaticResource QuietButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
