<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Filspresso.App.AgentWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Filspresso.App">
    <ScrollViewer>
        <StackPanel Padding="28,16,28,32" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="6"><TextBlock Text="Plan / Build" FontSize="26" /><TextBlock Text="Explore first. Make reviewed changes when you’re ready." FontSize="12" Foreground="{StaticResource FilspressoMuted}" /></StackPanel>
                <Button Grid.Column="1" Content="Back to chat" Click="OnBack" Style="{StaticResource QuietButtonStyle}" VerticalAlignment="Top" />
            </Grid>
            <TextBlock x:Name="ModelInfo" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoMuted}" />
            <TextBlock x:Name="UpdateNotice" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" />
            <ComboBox x:Name="ModeBox" SelectedIndex="0" Width="230" HorizontalAlignment="Left" SelectionChanged="OnModeChanged" AutomationProperties.Name="Agent mode">
                <ComboBoxItem Content="Plan · read &amp; explore" />
                <ComboBoxItem Content="Build · edit &amp; test" />
            </ComboBox>
            <TextBlock x:Name="ModeHint" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="CheckButton" Content="Check model" Click="OnCheck" Style="{StaticResource QuietButtonStyle}" />
                <Button x:Name="StopButton" Content="Stop" Click="OnStop" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
                <Button x:Name="NewButton" Content="New conversation" Click="OnNew" Style="{StaticResource QuietButtonStyle}" ToolTipService.ToolTip="Retains the staged project; clears conversation context and unlocks mode selection" />
            </StackPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="12" />
            <TextBlock x:Name="Error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" Foreground="{StaticResource FilspressoAccent}" FontSize="12" />
            <Expander x:Name="WorkspaceSetup" Header="Workspace setup" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="SystemCheck" TextWrapping="Wrap" FontSize="12" />
                    <ComboBox x:Name="IsolationBox" Header="Execution isolation (fixed while a workspace is active)" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnIsolationChanged">
                        <ComboBoxItem Content="Windows Sandbox VM · preferred · separate Windows kernel" />
                        <ComboBoxItem Content="Native restricted · opt-in fallback · shared host Windows kernel" />
                    </ComboBox>
                    <TextBlock Text="Windows Sandbox is preferred. Native restricted mode shares the host kernel and is not a VM or Codex MXC. Both use a staged copy with offline commands. Verify the selected boundary before starting." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" />
                    <TextBlock x:Name="ExecutionStatus" TextWrapping="Wrap" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="VerifySandboxButton" Content="Verify setup…" Click="OnVerifySandbox" Style="{StaticResource QuietButtonStyle}" />
                        <Button x:Name="EnableExecutionButton" Content="Start workspace" Click="OnEnableExecution" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
                        <Button x:Name="DiscardSandboxButton" Content="Discard" Click="OnDiscardSandbox" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Expander>
            <Expander Header="Project &amp; changes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="CheckpointPanel" Spacing="10">
                    <TextBlock Text="Import a local text baseline or start empty. Only the staged copy is edited. Review diffs before exporting; applying to the original requires separate confirmation. Deletions must be applied manually." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ImportButton" Content="Import folder…" Click="OnImportProject" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
                        <Button x:Name="ExportButton" Content="Export changes…" Click="OnExportCheckpoints" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
                        <Button x:Name="ArtifactButton" Content="Export file…" Click="OnExportArtifact" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock Text="Local file explorer · inert source preview, not rendered HTML or execution" FontSize="12" />
                    <StackPanel x:Name="ProjectFiles" Spacing="4" />
                    <StackPanel x:Name="CheckpointList" Spacing="6" />
                    <TextBlock x:Name="CheckpointSummary" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" />
                    <Expander x:Name="DiffExpander" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBox x:Name="DiffBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" MaxHeight="400" FontSize="12" FontFamily="Consolas" />
                    </Expander>
                </StackPanel>
            </Expander>
            <StackPanel x:Name="Activity" Spacing="12" />
            <Border x:Name="QuestionBorder" Visibility="Collapsed" BorderBrush="{StaticResource FilspressoBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="The agent has questions" FontSize="20" />
                    <TextBlock Text="Your answers clarify the request. They never approve file changes or commands." TextWrapping="Wrap" FontSize="12" />
                    <StackPanel x:Name="QuestionFields" Spacing="14" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Submit answers" Click="OnAnswer" Style="{StaticResource QuietButtonStyle}" />
                        <Button Content="Dismiss and stop" Click="OnDismiss" Style="{StaticResource QuietButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="ApprovalBorder" Visibility="Collapsed" BorderBrush="{StaticResource FilspressoBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Separate execution approval" FontSize="20" />
                    <TextBlock x:Name="ApprovalText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" />
                    <CheckBox x:Name="ReviewedAction" Content="I reviewed this exact action and workspace." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Approve once" Click="OnApprove" Style="{StaticResource QuietButtonStyle}" />
                        <Button Content="Deny this action" Click="OnDeny" Style="{StaticResource QuietButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource FilspressoSurface}" BorderBrush="{StaticResource FilspressoBorder}" BorderThickness="1" CornerRadius="16" Padding="14,8">
                <TextBox x:Name="PromptBox" Style="{StaticResource ComposerTextBoxStyle}" PlaceholderText="Describe your task or ask a follow-up…" AutomationProperties.Name="Agent message" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="220" MaxLength="8000" TextChanged="OnPromptChanged" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SendButton" Click="OnSend" Style="{StaticResource CopperButtonStyle}" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><local:SharedIcon IconName="send" Tone="dark" Width="16" Height="16" /><TextBlock Text="Send" Foreground="{StaticResource FilspressoAccentText}" /></StackPanel></Button>
                <Button x:Name="QueueButton" Content="Queue follow-up" Click="OnQueue" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
                <Button x:Name="CancelQueueButton" Content="Cancel queued" Click="OnCancelQueue" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
            </StackPanel>
            <TextBlock Text="Model turns and summaries are metered. Questions are not execution approval." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoMuted}" />
            <Expander Header="Safety &amp; advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10">
                <TextBlock Text="Each write, command and web request needs separate approval. Native mode has weaker isolation and limited tool compatibility; system/public resources may remain readable. No automatic fallback or unrestricted retry. Queued follow-ups run only after success, never after stop/failure. New conversation retains the staged project and resets context. Switching pages discards the workspace. Activity metadata is retained; the transcript stays client-local." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoMuted}" />
                <Button Content="Proposal preview (no executor)" Click="OnProposalReview" Style="{StaticResource QuietButtonStyle}" />
            </StackPanel></Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
