<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Filspresso.App.AgentWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Filspresso.App">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
        <StackPanel Spacing="8">
            <Button Content="Workspace…" Click="OnWorkspaceOptions" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" ToolTipService.ToolTip="Project files, model availability and isolated execution setup" />
            <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="11" Foreground="{StaticResource FilspressoMuted}" />
            <TextBlock x:Name="Error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" Foreground="{StaticResource FilspressoAccent}" FontSize="12" />
        </StackPanel>
        <ContentDialog x:Name="WorkspaceDialog" Title="Workspace" CloseButtonText="Done" DefaultButton="Close">
            <ScrollViewer MaxHeight="520"><StackPanel Spacing="14" MinWidth="400">
            <TextBlock Text="Your original folder is never edited automatically. Check the model, import a project, and start isolation only when you need it." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" />
            <Button x:Name="CheckButton" Content="Check model availability" Click="OnCheck" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" />
            <Expander x:Name="WorkspaceSetup" Header="Workspace setup" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="SystemCheck" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="Execution isolation · fixed while active" FontSize="11" Foreground="{StaticResource FilspressoMuted}" />
                    <local:ChoicePicker x:Name="IsolationBox" Options="Windows Sandbox VM · preferred|Native restricted · shared host kernel" SelectedIndex="0" HorizontalAlignment="Left" SelectionChanged="OnIsolationChanged" AutomationProperties.Name="Execution isolation" />
                    <TextBlock Text="Windows Sandbox is preferred. Native restricted mode shares the host kernel and is not a VM or Codex MXC. Both use a staged copy with offline commands. Verify the selected boundary before starting." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" />
                    <TextBlock x:Name="ExecutionStatus" TextWrapping="Wrap" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="VerifySandboxButton" Content="Verify setup…" Click="OnVerifySandbox" Style="{StaticResource QuietButtonStyle}" />
                        <Button x:Name="EnableExecutionButton" Content="Start workspace" Click="OnEnableExecution" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
                        <Button x:Name="DiscardSandboxButton" Content="Discard" Click="OnDiscardSandbox" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Expander>
            <Expander Header="Project &amp; changes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="CheckpointPanel" Spacing="10">
                    <TextBlock Text="Import a local text baseline or start empty. Only the staged copy is edited. Review diffs before exporting; applying to the original requires separate confirmation. Deletions must be applied manually." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ImportButton" Content="Import folder…" Click="OnImportProject" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
                        <Button x:Name="ExportButton" Content="Export changes…" Click="OnExportCheckpoints" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
                        <Button x:Name="ArtifactButton" Content="Export file…" Click="OnExportArtifact" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock Text="Local file explorer · inert source preview, not rendered HTML or execution" FontSize="12" />
                    <StackPanel x:Name="ProjectFiles" Spacing="4" />
                    <StackPanel x:Name="CheckpointList" Spacing="6" />
                    <TextBlock x:Name="CheckpointSummary" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" />
                    <Expander x:Name="DiffExpander" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBox x:Name="DiffBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" MaxHeight="400" FontSize="12" FontFamily="Consolas" />
                    </Expander>
                </StackPanel>
            </Expander>
            </StackPanel></ScrollViewer>
        </ContentDialog>
            <Border x:Name="QuestionBorder" Grid.Row="1" Visibility="Collapsed" BorderBrush="{StaticResource FilspressoBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="The agent has questions" FontSize="20" />
                    <TextBlock Text="Your answers clarify the request. They never approve file changes or commands." TextWrapping="Wrap" FontSize="12" />
                    <StackPanel x:Name="QuestionFields" Spacing="14" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Submit answers" Click="OnAnswer" Style="{StaticResource QuietButtonStyle}" />
                        <Button Content="Dismiss and stop" Click="OnDismiss" Style="{StaticResource QuietButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="ApprovalBorder" Grid.Row="2" Visibility="Collapsed" BorderBrush="{StaticResource FilspressoBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Separate execution approval" FontSize="20" />
                    <TextBlock x:Name="ApprovalText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" />
                    <CheckBox x:Name="ReviewedAction" Content="I reviewed this exact action and workspace." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Approve once" Click="OnApprove" Style="{StaticResource QuietButtonStyle}" />
                        <Button Content="Deny this action" Click="OnDeny" Style="{StaticResource QuietButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
    </Grid>
</UserControl>
