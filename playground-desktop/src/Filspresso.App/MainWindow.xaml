<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Filspresso.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" RowDefinitions="Auto,*,Auto" Loaded="OnLoaded">

        <Grid Padding="24,16" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
                <TextBlock Text="Filspresso Playground" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Name="Subtitle"
                    Text="Not signed in"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="AccountButton" Content="Sign in" Click="OnAccountClick" />
        </Grid>

        <!--
            The sign-in screen and the navigation are separate hosts, and only one is visible
            at a time. Putting the sign-in page inside the NavigationView would hide it
            entirely whenever the view is collapsed, which is exactly the state a signed-out
            user is in.
        -->
        <Grid x:Name="SignInHost" Grid.Row="1" />
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            Visibility="Collapsed"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Session" Tag="session" IsSelected="True">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Message" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Models" Tag="models">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Account" Tag="account">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Sandbox (Phase 4)" IsEnabled="False">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <InfoBar
            x:Name="EntitlementBar"
            Grid.Row="2"
            Margin="24,8,24,16"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

    </Grid>
</Window>