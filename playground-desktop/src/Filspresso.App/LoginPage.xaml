<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Filspresso.App.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The sign-in screen.

        Deliberately a page rather than a dialog: this is a state the user passes through on a
        first run, and a modal over an empty shell looks like an error rather than a first step.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="32" MaxWidth="510" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{StaticResource FilspressoSubtleSurface}" BorderBrush="{StaticResource FilspressoBorder}" BorderThickness="1" CornerRadius="20" Padding="32">
        <StackPanel Spacing="24">

            <StackPanel Spacing="4">
                <TextBlock Text="SPECTRE PLAYGROUND" FontSize="11" Foreground="{StaticResource FilspressoAccent}" Margin="0,0,0,12" />
                <TextBlock x:Name="Header" Text="Welcome back" FontSize="27" />
                <TextBlock
                    x:Name="Subheader"
                    Text="Your Playground access and wallet follow your account."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />

            <StackPanel x:Name="PasswordPanel" Spacing="12">
                <TextBox x:Name="EmailBox"
                         Header="Email"
                         PlaceholderText="you@example.com"
                         TextChanged="OnEmailChanged" />
                <PasswordBox x:Name="PasswordBox" Header="Password" PasswordChanged="OnPasswordChanged" />
            </StackPanel>

            <StackPanel x:Name="MfaPanel" Spacing="12" Visibility="Collapsed">
                <TextBox
                    x:Name="CodeBox"
                    Header="Authenticator code"
                    PlaceholderText="000000"
                    MaxLength="6"
                    TextChanged="OnCodeChanged" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" Visibility="Collapsed" />
                <Button x:Name="SubmitButton" Content="Sign in" Click="OnSubmit" Style="{StaticResource CopperButtonStyle}" />
            </StackPanel>

            <TextBlock
                Text="The Playground needs the Spectre subscription, or a Max or Ultimate plan."
                TextWrapping="Wrap"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

        </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
