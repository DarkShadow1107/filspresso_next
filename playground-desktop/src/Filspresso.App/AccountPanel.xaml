<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Filspresso.App.AccountPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="24">

        <TextBlock Text="Your account" FontSize="29" />

        <!-- The access state, which decides whether anything else on this page matters. -->
        <Border
            x:Name="AccessPanel"
            CornerRadius="8"
            Padding="16"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="Playground access" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="AccessValue" TextWrapping="Wrap" />
                <TextBlock
                    x:Name="AccessDetail"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Message is set from code: it is a plain string property, not a content slot. -->
        <InfoBar x:Name="UnavailablePanel" IsOpen="True" IsClosable="False" Severity="Warning" />

        <!--
            Plan, allowance and wallet as separate rows rather than one "balance" figure.

            They are not interchangeable: the allowance resets monthly and the wallet does not,
            and a user who sees a single number cannot tell which pot they are spending. The
            product charges from whichever can pay, so the screen has to show both.
        -->
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14" ColumnSpacing="20">
            <TextBlock Text="Plan" VerticalAlignment="Center" />
            <TextBlock x:Name="TierValue" Grid.Column="1" Text="—" FontWeight="SemiBold" />

            <TextBlock Grid.Row="1" Text="Monthly allowance" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock x:Name="AllowRemainingValue" Text="—" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock
                    x:Name="AllowResetValue"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Right" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Wallet" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock x:Name="WalletValue" Text="—" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock
                    x:Name="WalletDetail"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Right" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="Status" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock
                x:Name="StatusValue"
                Grid.Row="3"
                Grid.Column="1"
                Text="—"
                TextWrapping="Wrap"
                HorizontalAlignment="Right"
                MaxWidth="320" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefresh" />
            <Button Content="Sign out" Click="OnSignOutRequested" />
        </StackPanel>

    </StackPanel>
</UserControl>
