<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Filspresso.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Filspresso.App"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Poppins-Regular.ttf#Poppins</FontFamily>
            <FontFamily x:Key="FilspressoHeadingFont">ms-appx:///Assets/Fonts/Poppins-SemiBold.ttf#Poppins SemiBold</FontFamily>
            <Color x:Key="SystemAccentColor">#E4B38A</Color>
            <Color x:Key="SystemAccentColorLight1">#EFC9A7</Color>
            <Color x:Key="SystemAccentColorLight2">#F4D8BF</Color>
            <Color x:Key="SystemAccentColorLight3">#F8E5D4</Color>
            <Color x:Key="SystemAccentColorDark1">#BD8D65</Color>
            <Color x:Key="SystemAccentColorDark2">#8F6344</Color>
            <Color x:Key="SystemAccentColorDark3">#62432F</Color>
            <SolidColorBrush x:Key="FilspressoBackground" Color="#100F10" />
            <SolidColorBrush x:Key="FilspressoRail" Color="#141213" />
            <SolidColorBrush x:Key="FilspressoSurface" Color="#252020" />
            <SolidColorBrush x:Key="FilspressoSubtleSurface" Color="#1B1716" />
            <SolidColorBrush x:Key="FilspressoBorder" Color="#44352D" />
            <SolidColorBrush x:Key="FilspressoText" Color="#F2E5DC" />
            <SolidColorBrush x:Key="FilspressoMuted" Color="#A39994" />
            <SolidColorBrush x:Key="FilspressoAccent" Color="#E4B38A" />
            <SolidColorBrush x:Key="FilspressoAccentText" Color="#322418" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F2E5DC" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#BAA99B" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A39994" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#252020" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#302722" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#3A2E26" />
            <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#E4B38A" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E4B38A" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#F0C9A6" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#E4B38A" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#322418" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#211C19" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#44352D" />
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
            <Thickness x:Key="MenuFlyoutItemThemePadding">10,6</Thickness>
            <x:Double x:Key="MenuFlyoutItemMinHeight">30</x:Double>
            <Style x:Key="ComposerTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="2,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
                <Setter Property="Foreground" Value="{StaticResource FilspressoText}" />
            </Style>
            <Style x:Key="RailButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource FilspressoMuted}" />
            </Style>
            <Style x:Key="CopperButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{StaticResource FilspressoAccent}" />
                <Setter Property="Foreground" Value="{StaticResource FilspressoAccentText}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18,10" />
            </Style>
            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource FilspressoBorder}" />
                <Setter Property="Foreground" Value="{StaticResource FilspressoText}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,7" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>

</Application>
