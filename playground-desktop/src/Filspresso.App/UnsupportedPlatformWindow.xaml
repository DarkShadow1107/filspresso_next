<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Filspresso.App.UnsupportedPlatformWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shown when the installer was bypassed and the application starts on an edition whose
        sandbox cannot work. It exists to explain, not to apologise: the user needs to know
        which editions are supported and why this one is not, because "it just says no" is the
        version of this that gets filed as a bug.
    -->
    <Grid Padding="32" RowDefinitions="Auto,Auto,Auto" Background="{StaticResource FilspressoBackground}" RequestedTheme="Dark">
        <TextBlock
            Text="This Windows installation is not supported"
            Style="{StaticResource TitleTextBlockStyle}"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="Reason"
            Grid.Row="1"
            Margin="0,16,0,0"
            TextWrapping="Wrap"
            Style="{StaticResource BodyTextBlockStyle}" />

        <TextBlock
            Grid.Row="2"
            Margin="0,16,0,0"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Use a supported Windows x64 client, build 19041 or newer. Home supports inspection and separately verified native restricted mode. Windows Sandbox VM execution additionally needs Windows 11 24H2+, a supported Pro/Enterprise/Education edition, virtualization and the updated Sandbox client. Installation is not execution approval." />
    </Grid>
</Window>
