<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Filspresso.App.PlaygroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Filspresso.App">
    <Grid ColumnDefinitions="Auto,*">
        <Border x:Name="ConversationsPane" Visibility="Collapsed" Width="248" Background="{StaticResource FilspressoRail}" BorderBrush="{StaticResource FilspressoBorder}" BorderThickness="0,0,1,0" Padding="16">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16">
                <TextBlock Text="Conversations" FontSize="16" />
                <Button Grid.Row="1" Content="+ New conversation" Click="OnNewConversation" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" />
                <TextBox x:Name="ConversationSearch" Grid.Row="2" PlaceholderText="Search conversations…" AutomationProperties.Name="Search conversations" TextChanged="OnSearchChanged" />
                <ListView x:Name="ConversationsList" Grid.Row="3" SelectionChanged="OnConversationSelected" DisplayMemberPath="Title" SelectionMode="Single" />
                <TextBlock Grid.Row="4" Text="This session only. Export a conversation to keep a copy." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoMuted}" />
            </Grid>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <InfoBar x:Name="StateBar" Grid.Row="0" IsOpen="False" IsClosable="False" Margin="28,8" />
            <Grid x:Name="ChatLayout" Grid.Row="1" RowDefinitions="Auto,*,Auto,Auto" MaxWidth="950" Margin="44,16,44,8" VerticalAlignment="Center" HorizontalAlignment="Stretch" RowSpacing="8">
                <StackPanel x:Name="WelcomePanel" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,32" Spacing="10">
                    <FontIcon Glyph="&#xE8A5;" Foreground="{StaticResource FilspressoAccent}" FontSize="29" Margin="0,0,0,10" />
                    <TextBlock Text="Hello there" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="What would you like to explore?" FontSize="14" Foreground="{StaticResource FilspressoMuted}" HorizontalAlignment="Center" />
                </StackPanel>
                <ListView x:Name="Transcript" Grid.Row="1" SelectionMode="None" Visibility="Collapsed" Margin="0,0,0,12" IsTabStop="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,22" /></Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="10" HorizontalAlignment="Stretch" Padding="4,8">
                                <Border Background="{Binding BubbleBrush}" CornerRadius="14" Padding="14,10" HorizontalAlignment="{Binding BubbleAlignment}">
                                    <StackPanel Spacing="10">
                                        <Expander Header="Thinking" Visibility="{Binding ReasoningVisibility}" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Foreground="{StaticResource FilspressoMuted}" /></Expander>
                                        <local:MessageContent Text="{Binding Text}" TextSize="{Binding TextSize}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{Binding MetadataVisibility}">
                                    <Border Background="{StaticResource FilspressoSurface}" CornerRadius="6" Padding="8,4"><TextBlock Text="{Binding Role}" FontSize="10" Foreground="{StaticResource FilspressoAccent}" /></Border>
                                    <TextBlock Text="{Binding Metadata}" FontSize="10" Foreground="{StaticResource FilspressoMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding ActionsVisibility}">
                                    <Button Tag="{Binding}" Click="OnCopyMessage" ToolTipService.ToolTip="Copy message" AutomationProperties.Name="Copy message" Style="{StaticResource RailButtonStyle}" Width="30" Height="30"><SymbolIcon Symbol="Copy" /></Button>
                                    <Button Tag="{Binding}" Click="OnEditMessage" ToolTipService.ToolTip="Edit prompt" AutomationProperties.Name="Edit prompt" Visibility="{Binding EditVisibility}" Style="{StaticResource RailButtonStyle}" Width="30" Height="30"><SymbolIcon Symbol="Edit" /></Button>
                                    <Button Tag="{Binding}" Click="OnRegenerate" ToolTipService.ToolTip="Regenerate response" AutomationProperties.Name="Regenerate response" Visibility="{Binding RegenerateVisibility}" Style="{StaticResource RailButtonStyle}" Width="30" Height="30"><SymbolIcon Symbol="Refresh" /></Button>
                                    <Button Tag="{Binding}" Click="OnDeleteMessage" ToolTipService.ToolTip="Delete message" AutomationProperties.Name="Delete message" Style="{StaticResource RailButtonStyle}" Width="30" Height="30"><SymbolIcon Symbol="Delete" /></Button>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" x:Name="PromptPanel" Background="{StaticResource FilspressoSurface}" BorderBrush="{StaticResource FilspressoBorder}" BorderThickness="1" CornerRadius="22" Padding="18,14">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                        <Grid x:Name="EditingPanel" Visibility="Collapsed" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Editing prompt. Sending replaces its response and later messages." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoAccent}" />
                            <Button Grid.Column="1" Content="Cancel edit" Click="OnCancelEdit" Style="{StaticResource QuietButtonStyle}" />
                        </Grid>
                        <TextBox x:Name="PromptBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="200" MaxLength="8000" PlaceholderText="Type a message…" AutomationProperties.Name="Message" TextChanged="OnPromptChanged" KeyDown="OnPromptKeyDown" Background="Transparent" BorderThickness="0" Padding="0" />
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                            <Button Content="+" FontSize="22" Width="34" Height="34" CornerRadius="17" Background="#39302C" BorderThickness="0" Padding="0" AutomationProperties.Name="Conversation actions">
                                <Button.Flyout><MenuFlyout>
                                    <MenuFlyoutItem Text="New conversation" Click="OnNewConversation" />
                                    <MenuFlyoutItem Text="Export conversation" Click="OnExportConversation" />
                                    <MenuFlyoutItem Text="Import conversation" Click="OnImportConversation" />
                                    <MenuFlyoutItem Text="Settings" Click="OnSettings" />
                                </MenuFlyout></Button.Flyout>
                            </Button>
                            <Button x:Name="ContextButton" Grid.Column="1" Content="16K / 128K" Click="OnSettings" FontSize="10" Background="Transparent" BorderThickness="0" Foreground="{StaticResource FilspressoMuted}" Padding="4" AutomationProperties.Name="Context settings" />
                            <ToggleButton x:Name="ThinkingButton" Grid.Column="3" Content="Think" FontSize="10" Padding="8,4" Click="OnThinkingChanged" VerticalAlignment="Center" />
                            <ComboBox x:Name="ModelBox" Grid.Column="4" Width="235" MinHeight="32" SelectionChanged="OnModelChanged" DisplayMemberPath="Label" FontSize="11" VerticalAlignment="Center" AutomationProperties.Name="Model" />
                            <Grid Grid.Column="5">
                                <Button x:Name="SendButton" Content="↑" FontSize="22" Width="36" Height="36" Padding="0" CornerRadius="18" Click="OnSend" IsEnabled="False" Background="{StaticResource FilspressoAccent}" Foreground="{StaticResource FilspressoAccentText}" AutomationProperties.Name="Send message" />
                                <Button x:Name="CancelButton" Content="■" FontSize="16" Width="36" Height="36" Padding="0" CornerRadius="18" Click="OnStop" Visibility="Collapsed" Background="{StaticResource FilspressoAccent}" Foreground="{StaticResource FilspressoAccentText}" AutomationProperties.Name="Stop generation" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="3" Spacing="5" Margin="0,4,0,8">
                    <TextBlock x:Name="BalanceHint" Text="Direct model access · 128K context" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource FilspressoMuted}" />
                    <TextBlock x:Name="PriceHint" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource FilspressoMuted}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="PricesPanel" Grid.Row="1" Visibility="Collapsed">
                <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Padding="42,20,42,40" Spacing="16">
                    <TextBlock Text="API Prices" FontSize="29" />
                    <TextBlock Text="Every model. 128K context. Pay for the tokens you use." Foreground="{StaticResource FilspressoMuted}" />
                    <TextBlock Text="RON per 1M tokens · input / output" FontSize="11" Foreground="{StaticResource FilspressoAccent}" />
                    <ListView x:Name="CatalogueList" SelectionMode="None" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate><DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="28" Padding="0,18" MinWidth="520">
                                <StackPanel Spacing="5"><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding State}" FontSize="11" Foreground="{StaticResource FilspressoMuted}" /></StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Right"><TextBlock Text="{Binding Price}" Foreground="{StaticResource FilspressoAccent}" /><TextBlock Text="128K context" FontSize="10" Foreground="{StaticResource FilspressoMuted}" HorizontalAlignment="Right" /></StackPanel>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="RefreshButton" Content="Refresh account" Click="OnRefresh" Style="{StaticResource QuietButtonStyle}" />
                        <Button Content="Manage wallet / subscription" Click="OnManageAccount" Style="{StaticResource QuietButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
