<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Filspresso.App.PlaygroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Playground: a model picker, the catalogue, the conversation, and the prompt.

        The state banner is a permanent part of the layout rather than a toast. A toast
        disappears, and the states here are not transient: an account with no access stays
        locked, and an empty wallet stays empty. The user has to be able to read the state
        and then read their allowance, so both are always on screen.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" Padding="24">

        <InfoBar x:Name="StateBar" Grid.Row="0" IsOpen="True" IsClosable="False" Title="Checking account…" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button x:Name="RefreshButton" Content="Refresh account" Click="OnRefresh" />
            <Button Content="Manage subscription / wallet" Click="OnManageAccount" />
            <Button x:Name="CancelButton" Content="Stop" Click="OnStop" IsEnabled="False" />
            <TextBlock x:Name="BalanceHint" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
            <ComboBox x:Name="ModelBox" Header="Model" MinWidth="320" SelectionChanged="OnModelChanged" />
            <TextBlock x:Name="PriceHint" TextWrapping="Wrap" />
            <TextBlock
                Text="API usage prices per 1M tokens (RON) · INPUT / OUTPUT"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ListView x:Name="CatalogueList" SelectionMode="None" MaxHeight="210">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="16" Padding="0,3" MinWidth="600">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding Price}" />
                            <TextBlock Grid.Column="2" Text="{Binding State}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <ListView x:Name="Transcript" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4" Padding="0,8">
                        <TextBlock Text="{Binding Role}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            Text="{Binding Text}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            FontFamily="Cascadia Code, Consolas" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid x:Name="PromptPanel" Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox
                x:Name="PromptBox"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="72"
                MaxHeight="140"
                MaxLength="8000"
                PlaceholderText="Ask the model. Ctrl+Enter sends."
                TextChanged="OnPromptChanged">
                <!--
                    Ctrl+Enter sends. A multi-line prompt with no shortcut is a keyboard trap,
                    and plain Enter still inserts a newline, so the accelerator has to be the
                    explicit combination rather than Enter alone.
                -->
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnSendAccelerator" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <Button
                x:Name="SendButton"
                Grid.Column="1"
                Content="Send"
                Click="OnSend"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>