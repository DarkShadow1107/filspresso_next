<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Filspresso.App.InstructionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Filspresso.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Padding="4,0,12,8" MaxWidth="700">
            <StackPanel Spacing="5"><TextBlock Text="Windows desktop guide" FontSize="11" Foreground="{StaticResource FilspressoAccent}" /><TextBlock Text="Your workspace, with boundaries" FontSize="23" /><TextBlock Text="Hosted models. Local staged files. You decide what runs." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" /></StackPanel>
            <Border Background="{StaticResource FilspressoSubtleSurface}" CornerRadius="16" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="System &amp; updates" FontSize="16" />
                    <TextBlock x:Name="SystemFacts" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="VersionFacts" FontSize="12" />
                    <TextBlock x:Name="UpdateStatus" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="LastChecked" FontSize="10" Foreground="{StaticResource FilspressoMuted}" />
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="CheckUpdates" Content="Check for updates" Click="OnCheckUpdates" Style="{StaticResource QuietButtonStyle}" /><Button Content="Recheck PC" Click="OnRecheck" Style="{StaticResource QuietButtonStyle}" /><Button Content="Web account" Click="OnWebAccount" Style="{StaticResource QuietButtonStyle}" /></StackPanel>
                    <TextBlock Text="No automatic downloads, installation or restart. Only published packages can produce an update notice; a locally built MSI candidate is not a release. Unsigned/unqualified packages are not release-ready." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoMuted}" />
                </StackPanel>
            </Border>
            <StackPanel Spacing="7"><TextBlock Text="Chat · Plan · Build" FontSize="16" /><TextBlock Text="Choose a mode from the picker. Chat answers questions without executing code. Plan reads imported text and explores; it cannot write files or run commands. Build edits/tests a staged project only after you verify and explicitly start an isolated workspace." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" /></StackPanel>
            <StackPanel Spacing="7"><TextBlock Text="Start safely" FontSize="16" /><TextBlock Text="In Plan / Build, open Workspace setup → Verify. Windows Sandbox is preferred (eligible Windows 11 24H2+ edition, virtualization and Sandbox feature required). Home can inspect or explicitly opt in to qualified native restricted mode. Native mode shares the host kernel and is weaker than a VM; there is no silent fallback." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" /><TextBlock Text="The edition/build above come from this PC’s registry, not browser hints. They do not prove isolation is configured or safe. Verification probes and execution approval remain separate." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoMuted}" /></StackPanel>
            <StackPanel Spacing="7"><TextBlock Text="Bring a project, review a change" FontSize="16" /><TextBlock Text="Use + to attach sources in Chat; use Project &amp; changes to import a local text baseline for the agent. Nothing is applied to the original folder automatically. Review diffs, export changes and separately confirm applying them. Back up important work. Each write, command and web request needs fresh approval; answering a question is never execution consent." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" /></StackPanel>
            <StackPanel Spacing="7"><TextBlock Text="Keep context and understand usage" FontSize="16" /><TextBlock Text="Model turns, follow-ups and compaction summaries are metered. Changing mode after a completed agent turn needs a new conversation, which retains the staged project. Leaving the agent workspace discards it. Export Chat from Settings for a local transcript; saved sessions restore preferences/checkpoints, not full transcripts. Activity is retained metadata, not a rerun; records may expire or be clipped." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" /></StackPanel>
            <TextBlock Text="This guide is for the installed Windows app. The web Playground has its own Instructions for hosted workspaces and browser limitations." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoAccent}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
