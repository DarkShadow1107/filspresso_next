<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Filspresso.App.AgentReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28,16,28,32" Spacing="14" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Proposal preview" FontSize="26" />
            <TextBlock Text="Advanced · one metered model turn. Preview tool suggestions only; nothing is read, changed or executed. Use Plan / Build for the connected agent." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" />
            <TextBlock x:Name="ModelInfo" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" />
            <Expander Header="How this differs from Plan / Build" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock Text="This is a diagnostic preview, not an execution workspace. Model/context follow Chat settings; Chat messages and sources are not sent automatically. Changing settings, conversation or account clears the preview. No VM, tool approvals or follow-up loop is started." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" /></Expander>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button x:Name="CheckButton" Content="Check model" Click="OnCheck" Style="{StaticResource QuietButtonStyle}" />
                <Button x:Name="StopButton" Content="Stop review" IsEnabled="False" Click="OnStop" Style="{StaticResource QuietButtonStyle}" />
            </StackPanel>
            <TextBlock x:Name="ReviewStatus" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoMuted}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ReviewError" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FilspressoAccent}" AutomationProperties.LiveSetting="Assertive" />
            <ComboBox x:Name="ModeBox" Header="Preview mode" SelectedIndex="0" SelectionChanged="OnModeChanged" Width="260" HorizontalAlignment="Left">
                <ComboBoxItem Content="Plan suggestions" />
                <ComboBoxItem Content="Build suggestions · no execution" />
            </ComboBox>
            <TextBox x:Name="PromptBox" Header="Task to preview" PlaceholderText="Describe the task…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxLength="8000" TextChanged="OnPromptChanged" />
            <Button x:Name="GenerateButton" Content="Preview · metered" IsEnabled="False" Click="OnGenerate" Style="{StaticResource QuietButtonStyle}" />
            <TextBlock Text="Every explicit generation is metered. Cancellation may still consume billed tokens. Generated claims are not evidence that any file was read or any test ran." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoMuted}" />
            <TextBlock x:Name="Receipt" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11" />
            <TextBlock x:Name="AnswerHeading" Text="Model answer · unverified claims" Visibility="Collapsed" FontSize="17" />
            <TextBlock x:Name="Answer" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" FontFamily="Consolas" />
            <ItemsControl x:Name="Proposals" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="{StaticResource FilspressoBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel Spacing="9">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" />
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoMuted}" />
                            <TextBlock Text="{Binding Arguments}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11" FontFamily="Consolas" />
                            <Button Content="Execution approval unavailable" IsEnabled="False" Style="{StaticResource QuietButtonStyle}" />
                            <TextBlock Text="No workspace is connected. Reviewing this proposal does not approve or run it." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoMuted}" />
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="ClearButton" Content="Clear displayed review" IsEnabled="False" Click="OnClear" Style="{StaticResource QuietButtonStyle}" />
            <TextBlock Text="Clearing does not delete retained run metadata or undo billing. No tool results or approvals are sent back." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FilspressoMuted}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
