<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Filspresso.Sandbox</RootNamespace>
    <AssemblyName>Filspresso.Sandbox</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filspresso.Core\Filspresso.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The path handling and the string escaping are internal, and they are exactly the code
      that has to be right: a path that climbs out of the workspace, or a value that closes a
      quoted string, are both boundary failures. They are tested from here rather than made
      public for the sake of it.
    -->
    <InternalsVisibleTo Include="Filspresso.Core.Tests" />
  </ItemGroup>

</Project>